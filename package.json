{
  "name": "n8n-nodes-octen-official",
  "version": "0.1.1",
  "description": "n8n community node for the Octen API: web, news, business, place and media search, plus page extraction",
  "license": "MIT",
  "homepage": "https://github.com/Octen-Team/n8n-nodes-octen#readme",
  "bugs": {
    "url": "https://github.com/Octen-Team/n8n-nodes-octen/issues"
  },
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "octen",
    "web search",
    "search api",
    "ai agent"
  ],
  "author": {
    "name": "Octen",
    "email": "support@octen.ai"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Octen-Team/n8n-nodes-octen.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease",
    "test": "vitest run"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/OctenApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Octen/Octen.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "0.58.6",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^21.1.0",
    "typescript": "5.9.2",
    "vitest": "3.2.7"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
